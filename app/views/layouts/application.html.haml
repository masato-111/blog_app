!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Blog App"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "Blog App", :name => "application-name"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    %link{href: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css", rel: "stylesheet"}

    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload"
    = yield :head
    %link{:href => "/icon.png", :rel => "icon", :type => "image/png"}/
    %link{:href => "/icon.svg", :rel => "icon", :type => "image/svg+xml"}/
    %link{:href => "/icon.png", :rel => "apple-touch-icon"}/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload"
%body
  %nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4
    .container
      = link_to 'Blog App', posts_path, class: 'navbar-brand fw-bold'

      .d-flex.align-items-center
        - if user_signed_in?
          -# ログイン中の場合
          %span.navbar-text.me-3.small
            = current_user.email
          = button_to 'ログアウト', destroy_user_session_path, method: :delete, class: 'btn btn-outline-light btn-sm'
        - else
          -# ログアウト中の場合
          = link_to 'ログイン', new_user_session_path, class: 'btn btn-outline-light btn-sm me-2'
          = link_to '新規登録', new_user_registration_path, class: 'btn btn-primary btn-sm'

  = yield

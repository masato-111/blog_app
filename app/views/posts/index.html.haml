.container.mt-4
  .d-flex.justify-content-between.align-items-center.mb-4
    %h1 ホーム
    = link_to '新規投稿', new_post_path, class: 'btn btn-primary'

  - if @posts.present?
    .row.row-cols-1.row-cols-md-3.g-4
      - @posts.each do |post|
        .col
          .card.h-100.shadow-sm
            - if post.image.attached?
              = image_tag post.image, class: 'card-img-top post-thumbnail'
            .card-body
              %h5.card-title= post.title
              %p.card-text.text-muted= post.excerpt
            .card-footer.bg-transparent.border-0.pb-3
              = link_to '読む', post, class: 'btn btn-outline-primary btn-sm'
  - else
    .text-center.py-5.text-muted
      %p 投稿された記事はまだありません。
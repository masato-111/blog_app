.card-body
  = simple_form_for post do |f|
    .mb-3
      = f.input :title, label: 'タイトル', placeholder: 'タイトルを入力してください', input_html: { class: 'form-control' }
    .mb-3
      = f.input :description, as: :text, label: '本文・説明文', placeholder: '本文を入力してください', input_html: { rows: 5, class: 'form-control' }
    .mb-3
      = f.input :image, as: :file, label: 'アイキャッチ画像', input_html: { accept: 'image/*', class: 'form-control' }
    .d-flex.justify-content-between.align-items-center.mt-4
      = link_to '一覧へ戻る', posts_path, class: 'btn btn-outline-secondary'
      = f.button :submit, '投稿する', class: 'btn btn-primary px-4'
.container.mt-5
  .row.justify-content-center
    .col-md-8
      .card.shadow-sm
        .card-body.p-4
          -# タイトルと投稿日時
          %h1.h2.mb-3= @post.title
          .text-muted.mb-4.small
            投稿日: #{@post.created_at.strftime('%Y年%m月%d日 %H:%M')}

          -# 画像がある場合（横幅に合わせて自動調整・角丸）
          - if @post.image.attached?
            .text-center.mb-4
              = image_tag @post.image, class: 'img-fluid rounded', style: 'max-height: 400px; object-fit: cover;'

          -# 本文（simple_format を使うと文章中の改行がそのまま反映されます）
          .post-content.mb-5
            = simple_format(@post.description, class: 'lh-lg')

          %hr

          -# アクションボタン（編集・削除・戻る）
          .d-flex.justify-content-between.align-items-center
            = link_to 'ホームへ戻る', posts_path, class: 'btn btn-outline-secondary'

            .btn-group
              = link_to '編集', edit_post_path(@post), class: 'btn btn-outline-primary'
              = button_to '削除', post_path(@post), method: :delete, form: { data: { turbo_confirm: '本当に削除しますか？' } }, class: 'btn btn-outline-danger'